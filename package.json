{
  "name": "@knights-eye-chess/ai-analysis",
  "version": "0.1.0-dev.4",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src",
    "build.mjs",
    "npm-shrinkwrap.json",
    "tsconfig.json",
    "README.md",
    "test-types.mts",
    "test",
    "vendor",
    "SOURCE-ORIGIN.json",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/chess-reasoning/answer-pipeline-exports.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test dist/answer-pipeline.test.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM,DOM.Iterable test-types.mts",
    "check": "npm run build && npm test && npm run test:types",
    "pack:checked": "npm run check && node scripts/pack.mjs",
    "pack:artifact": "node scripts/pack.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "ai": "7.0.85",
    "@ai-sdk/provider": "4.0.9",
    "@ai-sdk/provider-utils": "5.0.34",
    "chess.js": "1.4.0",
    "@types/json-schema": "7.0.15",
    "@types/node": "22.19.19"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knights-eye-chess/ai-analysis.git"
  }
}
