{
  "name": "@knights-eye-chess/ai-analysis",
  "version": "0.1.0-dev.30",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src",
    "build.mjs",
    "tsconfig.json",
    "README.md",
    "test-types.mts",
    "test",
    "SOURCE-ORIGIN.json",
    "scripts",
    "LICENSE",
    "NOTICE",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "NPM-PUBLISHING.md",
    "npm-release.json",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/chess-reasoning/answer-pipeline-exports.d.ts",
      "import": "./dist/index.js"
    },
    "./research": {
      "types": "./dist/types/chess-reasoning/research-exports.d.ts",
      "import": "./dist/research.js"
    },
    "./shared": {
      "types": "./dist/types/shared-exports.d.ts",
      "import": "./dist/shared.js"
    },
    "./engine": {
      "types": "./dist/types/chess-reasoning/engine-analysis-provider.d.ts",
      "import": "./dist/engine.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test dist/answer-pipeline.test.mjs dist/owner-tests/*.test.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM,DOM.Iterable test-types.mts",
    "check": "npm run build && npm test && npm run test:types",
    "pack:checked": "npm run check && node scripts/pack.mjs",
    "pack:artifact": "node scripts/pack.mjs",
    "publish:verify": "node scripts/verify-release.mjs",
    "publish:prepare": "npm run pack:checked && npm run publish:verify"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.9",
    "@ai-sdk/provider-utils": "5.0.34",
    "@knights-eye-chess/move-classifier": "0.1.0-dev.17.1",
    "@types/json-schema": "7.0.15",
    "@types/node": "22.19.19",
    "ai": "7.0.85",
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knights-eye-chess/ai-analysis.git"
  },
  "license": "AGPL-3.0-or-later"
}
